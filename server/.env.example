# Server
PORT=4173
FRONTEND_ORIGIN=*
COMMERCIAL_MODE=0
SOURCE_SYNC_MINUTES=30

# AI analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Payment adapter. The checkout service returns { checkoutUrl, orderId }.
PAYMENT_PROVIDER=wechat_or_alipay
PAYMENT_CHECKOUT_ENDPOINT=
PAYMENT_SERVICE_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# Optional OCR/provider fallback. TXT, text PDFs and DOCX are parsed locally.
# Receives { fileName, mimeType, base64 } and returns { text }.
RESUME_PARSER_ENDPOINT=

# Only fill these after receiving written BOSS official access.
BOSS_OFFICIAL_API_ENDPOINT=
BOSS_OFFICIAL_API_TOKEN=

# Local QA only. Never enable in a public deployment.
ALLOW_DEMO_BILLING=0
